{
  "name": "dsh-obsidian-vault",
  "version": "0.1.1",
  "description": "Obsidian-style notes panel for DeepSeek Harness Web: vault directory tree, markdown preview/edit/save, one-click cite-to-chat, configurable vault root. DSH 内嵌 Obsidian 风格笔记面板：目录树 + Markdown 预览/编辑/保存 + 一键引用到对话 + 可配置 Vault 目录。",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "obsidian",
    "notes",
    "markdown",
    "vault"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
